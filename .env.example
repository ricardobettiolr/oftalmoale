# Destination for appointment request emails
APPOINTMENT_TO_EMAIL=agenda@oftalmoale.com

# Namecheap Private Email (or any SMTP provider)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
EMAIL_USER=agenda@oftalmoale.com
EMAIL_PASS=

# Port 465 uses SSL (secure: true). Use 587 for STARTTLS.

# Sistema del consultorio (/sistema) y agenda. Supabase > Project Settings > API.
# Sin estas variables el sitio publico funciona igual (el formulario solo envia
# el correo) y /sistema responde "no configurado".
# La clave anon/publishable es publica por diseno: lo que protege los datos es
# el Row Level Security de supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
